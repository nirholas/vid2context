// Cloudflare Worker for vid2context.com: the landing page (site/) and the HTTP API (/api/*).
// Deploy with `npm run deploy` (needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in .env).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vid2context",
  "main": "packages/server/src/workers.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "vid2context.com", "custom_domain": true },
    { "pattern": "www.vid2context.com", "custom_domain": true }
  ],
  // Also serve on vid2context.<account>.workers.dev, a fallback URL that works without the custom domain.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
