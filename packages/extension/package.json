{
  "name": "@vid2context/extension",
  "version": "0.1.0",
  "private": true,
  "description": "vid2context browser extension: copy an agent-ready transcript, download a .zip or open any video in vid2context. On YouTube it works in the page, with no server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/extension",
    "e2e": "LIVE=1 playwright test -c e2e/playwright.config.ts",
    "lint:firefox": "npx --yes web-ext@10.8.0 lint --source-dir dist/firefox",
    "record": "tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vid2context/core": "*",
    "@vid2context/provider-youtube": "*",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
