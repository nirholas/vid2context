{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vid2context config",
  "type": "object",
  "description": "vid2context config file.",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of the JSON Schema, for editors."
    },
    "version": {
      "const": 1,
      "description": "Config format version."
    },
    "defaultProfile": {
      "type": "string",
      "description": "Profile used when none is chosen. Default: \"default\".",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "profiles": {
      "type": "object",
      "description": "Named profiles.",
      "properties": {},
      "additionalProperties": {
        "type": "object",
        "description": "One named set of settings.",
        "properties": {
          "description": {
            "type": "string",
            "description": "What this profile is for. Shown by explain."
          },
          "extends": {
            "type": "string",
            "description": "Another profile to start from. Settings here override it.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "policy": {
            "description": "Rung order policy: one value for every stage, or an object with default and per-stage values.",
            "anyOf": [
              {
                "type": "string",
                "enum": ["free", "local-only", "quality"],
                "description": "free: local, free, keyless, then paid. local-only: nothing leaves the machine. quality: best first."
              },
              {
                "type": "object",
                "properties": {
                  "default": {
                    "type": "string",
                    "enum": ["free", "local-only", "quality"],
                    "description": "Rung order policy for every stage without its own value."
                  },
                  "stt": {
                    "type": "string",
                    "enum": ["free", "local-only", "quality"],
                    "description": "Rung order policy for stt rungs."
                  },
                  "llm": {
                    "type": "string",
                    "enum": ["free", "local-only", "quality"],
                    "description": "Rung order policy for llm rungs."
                  },
                  "embed": {
                    "type": "string",
                    "enum": ["free", "local-only", "quality"],
                    "description": "Rung order policy for embed rungs."
                  },
                  "video": {
                    "type": "string",
                    "enum": ["free", "local-only", "quality"],
                    "description": "Rung order policy for video rungs."
                  },
                  "visual": {
                    "type": "string",
                    "enum": ["free", "local-only", "quality"],
                    "description": "Rung order policy for visual rungs."
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "allowPaid": {
            "type": "boolean",
            "description": "Allow paid rungs. They still run only when their key is set, and only after every free rung."
          },
          "keyless": {
            "type": "boolean",
            "description": "Allow keyless hosted rungs (no account, but data goes to a third party)."
          },
          "prefer": {
            "description": "Rungs, services or providers to move to the front: one value for every stage, or an object with default and per-stage values.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "A rung id (llm/groq/openai/gpt-oss-120b), a service (groq) or a provider (llm-openai-compatible).",
                  "minLength": 1
                }
              },
              {
                "type": "object",
