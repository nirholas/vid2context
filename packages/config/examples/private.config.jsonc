// vid2context config, local-only profile only. Copy to ./vid2context.config.jsonc
// or ~/.config/vid2context/config.json. Keys never go here: they stay in .env.
// Reference: docs/configuration.md
{
  "$schema": "../schema/config.schema.json",
  "version": 1,
  "defaultProfile": "private",
  "profiles": {
    // Nothing leaves this machine: only local rungs (Ollama, LM Studio, a local
    // Whisper server). Keyless and paid hosts are switched off as well.
    "private": {
      "description": "Local only: nothing leaves this machine.",
      "policy": "local-only",
      "keyless": false,
      "allowPaid": false
    }
  }
}
