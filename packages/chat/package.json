{
  "name": "@vid2context/chat",
  "version": "0.1.0",
  "private": true,
  "description": "Chat workspace for vid2context: talk to your videos, pick the model, get streaming answers with timestamp citations. Static app served at /chat/.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
