{
  "videoId": "media:8bf3c9a2c444d0d789ce3cd80bca09de",
  "url": "https://images-assets.nasa.gov/video/Why%20Does%20the%20Moon%20Look%20Larger%20at%20the%20Horizo/Why%20Does%20the%20Moon%20Look%20Larger%20at%20the%20Horizo~mobile.mp4",
  "title": "Why Does the Moon Look Larger at the Horizon? We Asked a NASA Expert",
  "language": "en",
  "origin": "creator-captions",
  "producer": "publisher-subtitles",
  "recordedAt": "2026-11-15",
  "source": "https://images-assets.nasa.gov/video/Why%20Does%20the%20Moon%20Look%20Larger%20at%20the%20Horizo/Why%20Does%20the%20Moon%20Look%20Larger%20at%20the%20Horizo.srt",
  "segments": [
    {
      "startSec": 0.233,
      "endSec": 2.8689999999999998,
      "text": "Why does the Moon look larger at the horizon?"
    },
    {
      "startSec": 3.536,
      "endSec": 5.105,
      "text": "We Asked a NASA Expert."
    },
    {
      "startSec": 5.338,
      "endSec": 8.341,
      "text": "So why does the Moon look larger on the horizon?"
    },
    {
      "startSec": 8.541,
      "endSec": 10.41,
      "text": "The short answer is we don't know."
    },
    {
      "startSec": 10.41,
      "endSec": 12.846,
      "text": "We've been talking about this for 2,000 years."
    },
    {
      "startSec": 12.846,
      "endSec": 14.28,
      "text": "Aristotle mentions it."
    },
    {
      "startSec": 14.28,
      "endSec": 15.415,
      "text": "And in our own time,"
    },
    {
      "startSec": 15.415,
      "endSec": 17.15,
      "text": "scientists are designing experiments"
    },
    {
      "startSec": 17.15,
      "endSec": 19.352,
      "text": "to figure out exactly what's going on."
    },
    {
      "startSec": 19.352,
      "endSec": 21.354,
      "text": "But there's no consensus yet."
    },
    {
      "startSec": 21.354,
      "endSec": 22.689,
      "text": "Here's what we do know."
    },
    {
      "startSec": 22.689,
      "endSec": 24.991,
      "text": "The atmosphere isn't magnifying the Moon."
    },
    {
      "startSec": 24.991,
      "endSec": 28.561,
      "text": "If anything, atmospheric refraction squashes it a little bit."
    },
    {
      "startSec": 28.561,
      "endSec": 31.131,
      "text": "And the Moon's not closer to us at the horizon."
    },
    {
      "startSec": 31.131,
      "endSec": 34.134,
      "text": "It's about 1.5 percent farther away."
    },
    {
      "startSec": 34.167,
      "endSec": 36.002,
      "text": "Also, it isn't just the Moon."
    },
    {
      "startSec": 36.002,
      "endSec": 38.772,
      "text": "Constellations look huge on the horizon, too."
    },
    {
      "startSec": 38.772,
      "endSec": 42.509,
      "text": "One popular idea is that this is a variation"
    },
    {
      "startSec": 42.509,
      "endSec": 43.81,
      "text": "on the Ponzo illusion."
    },
    {
      "startSec": 43.81,
      "endSec": 45.378,
      "text": "Everything in our experience"
    },
    {
      "startSec": 45.378,
      "endSec": 47.347,
      "text": "seems to shrink as it recedes"
    },
    {
      "startSec": 47.347,
      "endSec": 48.248,
      "text": "toward the horizon —"
    },
    {
      "startSec": 48.248,
      "endSec": 51.117,
      "text": "I mean clouds and planes and cars and ships."
    },
    {
      "startSec": 51.117,
      "endSec": 52.752,
      "text": "But the Moon doesn't do that."
    },
    {
      "startSec": 52.752,
      "endSec": 54.554,
      "text": "So our minds make up a story"
    },
    {
      "startSec": 54.554,
      "endSec": 56.589,
      "text": "to reconcile this inconsistency."
    },
    {
      "startSec": 56.589,
      "endSec": 57.957,
      "text": "Somehow the Moon gets bigger"
    },
    {
      "startSec": 57.957,
      "endSec": 59.259,
      "text": "when it's at the horizon."
    },
    {
      "startSec": 59.259,
      "endSec": 61.094,
      "text": "That's one popular hypothesis,"
    },
    {
      "startSec": 61.094,
      "endSec": 62.328,
      "text": "but there are others."
    },
    {
      "startSec": 62.328,
      "endSec": 64.831,
      "text": "And we're still waiting for the experiment"
    },
    {
      "startSec": 64.831,
      "endSec": 66.499,
      "text": "that will convince everyone"
    },
    {
      "startSec": 66.499,
      "endSec": 68.068,
      "text": "that we understand this."
    },
    {
      "startSec": 68.068,
      "endSec": 71.071,
      "text": "So why does the Moon look larger on the horizon?"
    },
    {
      "startSec": 71.237,
      "endSec": 72.472,
      "text": "We don't really know,"
    },
    {
      "startSec": 72.472,
      "endSec": 74.707,
      "text": "but scientists are still trying to figure it out."
    },
    {
      "startSec": 75.008,
      "endSec": 76.209,
      "text": "We Asked a NASA Expert."
    },
    {
      "startSec": 76.209,
      "endSec": 78.912,
      "text": "NASA. A NASA 360 Production."
    }
  ]
}
