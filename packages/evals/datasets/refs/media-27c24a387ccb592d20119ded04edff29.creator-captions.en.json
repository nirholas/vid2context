{
  "videoId": "media:27c24a387ccb592d20119ded04edff29",
  "url": "https://images-assets.nasa.gov/video/How%20Can%20I%20See%20the%20Northern%20Lights/How%20Can%20I%20See%20the%20Northern%20Lights~mobile.mp4",
  "title": "How Can I See the Northern Lights? We Asked a NASA Expert",
  "language": "en",
  "origin": "creator-captions",
  "producer": "publisher-subtitles",
  "recordedAt": "2026-11-15",
  "source": "https://images-assets.nasa.gov/video/How%20Can%20I%20See%20the%20Northern%20Lights/How%20Can%20I%20See%20the%20Northern%20Lights.srt",
  "segments": [
    {
      "startSec": 0.033,
      "endSec": 3.169,
      "text": "How can I see the northern lights?"
    },
    {
      "startSec": 3.77,
      "endSec": 6.506,
      "text": "We asked a NASA scientist."
    },
    {
      "startSec": 6.773,
      "endSec": 7.307,
      "text": "To see the"
    },
    {
      "startSec": 7.307,
      "endSec": 8.441,
      "text": "northern lights,"
    },
    {
      "startSec": 8.441,
      "endSec": 9.843,
      "text": "you need to be in the right place"
    },
    {
      "startSec": 9.843,
      "endSec": 11.311,
      "text": "at the right time."
    },
    {
      "startSec": 11.311,
      "endSec": 12.579,
      "text": "Auroras are the result"
    },
    {
      "startSec": 12.579,
      "endSec": 14.08,
      "text": "of charged particles"
    },
    {
      "startSec": 14.08,
      "endSec": 15.081,
      "text": "and magnetism"
    },
    {
      "startSec": 15.081,
      "endSec": 17.083,
      "text": "from the Sun called space weather"
    },
    {
      "startSec": 17.083,
      "endSec": 19.019,
      "text": "dancing with the Earth's magnetic field."
    },
    {
      "startSec": 19.019,
      "endSec": 21.721,
      "text": "And they happen far above the clouds."
    },
    {
      "startSec": 21.721,
      "endSec": 24.457,
      "text": "So you need clear skies,"
    },
    {
      "startSec": 24.457,
      "endSec": 27.46,
      "text": "good space weather at your latitude"
    },
    {
      "startSec": 27.727,
      "endSec": 29.829,
      "text": "and the higher, more polar"
    },
    {
      "startSec": 29.829,
      "endSec": 30.797,
      "text": "you can be, the better."
    },
    {
      "startSec": 30.797,
      "endSec": 32.265,
      "text": "You need a lot of patience"
    },
    {
      "startSec": 32.265,
      "endSec": 34.968,
      "text": "and some luck is always helpful."
    },
    {
      "startSec": 34.968,
      "endSec": 38.071,
      "text": "A smartphone can also really help confirm"
    },
    {
      "startSec": 38.071,
      "endSec": 38.972,
      "text": "whether you saw"
    },
    {
      "startSec": 38.972,
      "endSec": 39.472,
      "text": "a little"
    },
    {
      "startSec": 39.472,
      "endSec": 41.541,
      "text": "bit of kind of dim aurora,"
    },
    {
      "startSec": 41.541,
      "endSec": 43.376,
      "text": "because cameras are more sensitive"
    },
    {
      "startSec": 43.376,
      "endSec": 44.511,
      "text": "than our eyes."
    },
    {
      "startSec": 44.511,
      "endSec": 45.345,
      "text": "The best months"
    },
    {
      "startSec": 45.345,
      "endSec": 46.513,
      "text": "to see aurorae,"
    },
    {
      "startSec": 46.513,
      "endSec": 49.315,
      "text": "statistically, are March and September."
    },
    {
      "startSec": 49.315,
      "endSec": 51.017,
      "text": "The best times to be looking"
    },
    {
      "startSec": 51.017,
      "endSec": 52.886,
      "text": "are around midnight,"
    },
    {
      "startSec": 52.886,
      "endSec": 53.82,
      "text": "but sometimes"
    },
    {
      "startSec": 53.82,
      "endSec": 55.388,
      "text": "when the Sun is super active,"
    },
    {
      "startSec": 55.388,
      "endSec": 56.723,
      "text": "it can happen"
    },
    {
      "startSec": 56.723,
      "endSec": 60.06,
      "text": "any time from sunset to sunrise."
    },
    {
      "startSec": 60.093,
      "endSec": 61.928,
      "text": "You can also increase your chances"
    },
    {
      "startSec": 61.928,
      "endSec": 64.431,
      "text": "by learning more about space weather data"
    },
    {
      "startSec": 64.431,
      "endSec": 65.432,
      "text": "and a great place to do"
    },
    {
      "startSec": 65.432,
      "endSec": 67.333,
      "text": "that is at the NOAA Space Weather"
    },
    {
      "startSec": 67.333,
      "endSec": 68.601,
      "text": "Prediction Center."
    },
    {
      "startSec": 68.601,
      "endSec": 69.769,
      "text": "You can also check out"
    },
    {
      "startSec": 69.769,
      "endSec": 72.405,
      "text": "my project Aurorasaurus.org,"
    },
    {
      "startSec": 72.405,
      "endSec": 74.04,
      "text": "where we have free alerts"
    },
    {
      "startSec": 74.04,
      "endSec": 76.142,
      "text": "that are based on your location"
    },
    {
      "startSec": 76.142,
      "endSec": 77.944,
      "text": "and we offer information"
    },
    {
      "startSec": 77.944,
      "endSec": 80.18,
      "text": "about how to interpret the data."
    },
    {
      "startSec": 80.18,
      "endSec": 82.015,
      "text": "And you can also report"
    },
    {
      "startSec": 82.015,
      "endSec": 82.682,
      "text": "and tell us"
    },
    {
      "startSec": 82.682,
      "endSec": 85.685,
      "text": "if you were able to see aurora or not"
    },
    {
      "startSec": 85.819,
      "endSec": 87.353,
      "text": "and that helps others."
    },
    {
      "startSec": 87.353,
      "endSec": 90.59,
      "text": "One last tip is finding a safe,"
    },
    {
      "startSec": 90.924,
      "endSec": 92.959,
      "text": "dark sky viewing location"
    },
    {
      "startSec": 92.959,
      "endSec": 95.495,
      "text": "with a great view of the northern horizon"
    },
    {
      "startSec": 95.495,
      "endSec": 96.329,
      "text": "that's near you."
    },
    {
      "startSec": 97.397,
      "endSec": 99.499,
      "text": "We asked a NASA scientist."
    },
    {
      "startSec": 100.8,
      "endSec": 103.77,
      "text": "NASA. A NASA 360 Production"
    }
  ]
}
