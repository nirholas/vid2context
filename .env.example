# vid2context configuration. Copy to .env and set only what you want.
# Every variable is optional: with none set, vid2context uses YouTube captions
# plus the keyless speech-to-text and LLM lanes. Shell variables override .env.
# Full table of rungs and free limits: docs/providers.md

# ---------------------------------------------------------------- chain controls

# Rung order: free (local, free, keyless, paid; default), local-only (nothing
# leaves this machine) or quality (best model first, tier as tie-breaker).
# VID2CONTEXT_POLICY=free

# 0 = never use paid rungs, even when their key is set.
# VID2CONTEXT_ALLOW_PAID=1

# 0 = turn off keyless rungs (OVH, Pollinations). They need no account but send
# your audio and prompts to a third party.
# VID2CONTEXT_KEYLESS=1

# Skip rungs by id, service or provider, comma-separated.
# VID2CONTEXT_SKIP=pollinations,ovh

# debug | info | warn | error | silent (logs go to stderr).
# VID2CONTEXT_LOG_LEVEL=warn

# Another env file to load before ./.env, e.g. for the MCP server started from
# another project's directory.
# VID2CONTEXT_ENV_FILE=/home/you/.config/vid2context/.env

# ---------------------------------------------------------------- local (your machine)

# Any OpenAI-compatible speech-to-text server (speaches, faster-whisper-server, LocalAI).
# LOCAL_STT_BASE_URL=http://localhost:8000/v1
# LOCAL_STT_MODEL=Systran/faster-whisper-large-v3
# LOCAL_STT_API_KEY=

# Ollama: set a model you have pulled to enable it.
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# LM Studio: set the loaded model's id to enable it.
# LMSTUDIO_MODEL=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Any other OpenAI-compatible chat server (llama.cpp, vLLM, Jan).
# LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_API_KEY=

# ---------------------------------------------------------------- free tiers (your key)
# <PROVIDER>_FALLBACK_KEYS adds extra keys, comma-separated; each becomes its own
# rung with its own quota. Keep <PROVIDER>_API_KEY a single key.
# <PROVIDER>_MODEL replaces a lane's LLM model list (comma-separated, in order).

# Groq: speech-to-text (whisper-large-v3-turbo) and LLMs (qwen3.8-27b,
# gpt-oss-120b, gpt-oss-20b). https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_FALLBACK_KEYS=
# GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Cerebras: gpt-oss-120b, llama-3.3-70b. https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# CEREBRAS_FALLBACK_KEYS=
# CEREBRAS_MODEL=gpt-oss-120b,llama-3.3-70b

# Mistral Experiment plan: mistral-small-latest. https://console.mistral.ai
# MISTRAL_API_KEY=
# MISTRAL_FALLBACK_KEYS=
# MISTRAL_MODEL=mistral-small-latest

# GitHub Models: any GitHub token. https://github.com/settings/tokens
# GITHUB_TOKEN=
# GITHUB_FALLBACK_KEYS=
# GITHUB_MODEL=meta/Llama-3.3-70B-Instruct

# Gemini AI Studio: gemini-2.5-flash-lite. https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_FALLBACK_KEYS=
# GEMINI_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------- keyless (no account)

# OVH AI Endpoints: whisper-large-v3-turbo, Llama 3.3 70B, gpt-oss-120b.
# About 2 requests per minute per model per IP.
# OVH_STT_MODEL=whisper-large-v3-turbo
# OVH_MODEL=Meta-Llama-3_3-70B-Instruct,gpt-oss-120b

# Pollinations anonymous tier.
# POLLINATIONS_MODEL=openai-fast

# ---------------------------------------------------------------- paid (last backstop)

# OpenAI: whisper-1 and gpt-5.4-nano. Used only after every free rung failed.
# OPENAI_API_KEY=
# OPENAI_FALLBACK_KEYS=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_STT_MODEL=whisper-1

# ---------------------------------------------------------------- YouTube

# Innertube ANDROID client version. Raise it if YouTube starts rejecting requests.
# YOUTUBE_ANDROID_VERSION=20.10.38

# ---------------------------------------------------------------- exports

# Notion: an internal integration secret (free) from
# https://www.notion.so/profile/integrations. Share the parent page with the
# integration (page menu, Connections). Obsidian exports need nothing.
# NOTION_TOKEN=
# Page the video pages are created under (its id or link).
# NOTION_PARENT_PAGE_ID=

# ---------------------------------------------------------------- content filters

# SponsorBlock (free, keyless): finds sponsor reads, self-promotion, intros and
# outros in YouTube videos. Only a 4-character hash prefix of the video id is
# sent. Data is CC BY-NC-SA 4.0 (non-commercial). Set 0 to turn lookups off.
# VID2CONTEXT_SPONSORBLOCK=1
# A self-hosted mirror instead of the public server.
# SPONSORBLOCK_API_URL=https://sponsor.ajay.app
# Default categories for skip=1 and get_skip_segments.
# VID2CONTEXT_SKIP_CATEGORIES=sponsor,selfpromo,interaction,intro,outro,preview,filler

# ---------------------------------------------------------------- yt-dlp (any video site, Node only)
# Guide: docs/guides/ytdlp.md. Without YTDLP_PATH or yt-dlp on PATH, the official
# release is downloaded into .vid2context/bin/ (SHA-256 verified) on first use.

# Use this yt-dlp binary instead (never auto-updated).
# YTDLP_PATH=/usr/local/bin/yt-dlp

# 0 = do not check for a new yt-dlp release (the managed copy checks weekly).
# YTDLP_AUTO_UPDATE=1

# One timeout in seconds for every yt-dlp run. Unset: 60 metadata, 120
# playlists and subtitles, 300 audio and comments.
# YTDLP_TIMEOUT_SEC=300

# Most yt-dlp processes at once per Node process.
# YTDLP_CONCURRENCY=2

# Cookies for sites that want a signed-in session. Values are never logged.
# YTDLP_COOKIES_FILE=/home/you/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=firefox

# ffmpeg for audio extraction (else ffmpeg on PATH, then ~/.local/bin/ffmpeg).
# FFMPEG_PATH=/usr/bin/ffmpeg

# ---------------------------------------------------------------- HTTP server (npm run start:server)

# PORT=8787
# HOST=127.0.0.1
