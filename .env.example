# vid2context configuration. Copy to .env and set only what you want.
# Every variable is optional: with none set, vid2context uses YouTube captions
# plus the keyless speech-to-text and LLM lanes. Shell variables override .env.
# Full table of rungs and free limits: docs/providers.md

# ---------------------------------------------------------------- chain controls

# Rung order: free (local, free, keyless, paid; default), local-only (nothing
# leaves this machine) or quality (best model first, tier as tie-breaker).
# VID2CONTEXT_POLICY=free

# 0 = never use paid rungs, even when their key is set.
# VID2CONTEXT_ALLOW_PAID=1

# 0 = turn off keyless rungs (OVH, Pollinations). They need no account but send
# your audio and prompts to a third party.
# VID2CONTEXT_KEYLESS=1

# Skip rungs by id, service or provider, comma-separated.
# VID2CONTEXT_SKIP=pollinations,ovh

# ---------------------------------------------------------------- security and limits (docs/security/hardening.md)

# 1 = public server or remote MCP endpoint: refuse local file paths, file:// and
# URLs that point at private, loopback, link-local or cloud metadata addresses.
# VID2CONTEXT_PUBLIC=0

# Caps shared by every package (defaults shown).
# VID2CONTEXT_MAX_INPUT_CHARS=2048
# VID2CONTEXT_MAX_PLAYLIST_ITEMS=500
# VID2CONTEXT_MAX_UPLOAD_MB=200
# VID2CONTEXT_MAX_AUDIO_MB=1024
# VID2CONTEXT_MAX_SEGMENTS=200000
# VID2CONTEXT_FETCH_TIMEOUT_MS=30000

# debug | info | warn | error | silent (logs go to stderr).
# VID2CONTEXT_LOG_LEVEL=warn

# json = one JSON object per log line (ts, level, msg, fields, trace_id and
# span_id inside a span). Default: the human text format.
# VID2CONTEXT_LOG_FORMAT=text

# MCP: ask the user (MCP elicitation) before speech-to-text on audio at least
# this many minutes long, in clients that support it. 0 = always ask.
# VID2CONTEXT_CONFIRM_STT_MINUTES=20

# ---------------------------------------------------------------- observability (docs/observability.md)

# Per process, per UTC day: once estimated paid spend reaches this many USD,
# paid rungs are skipped with reason "budget". Needs telemetry with a ledger.
# VID2CONTEXT_MAX_PAID_USD_PER_DAY=1

# Price of a rung, to estimate paid spend. Name: the rung id upper-cased, the
# pooled-key suffix (#2) dropped, other characters as "_". Value: "in,out" USD
# per million tokens for LLMs, or USD per audio minute for speech-to-text.
# Defaults exist only for prices verified on the vendor page (see the doc).
# VID2CONTEXT_PRICE_LLM_OPENAI_GPT_5_4_NANO=0.20,1.25
# VID2CONTEXT_PRICE_STT_OPENAI_WHISPER_1=0.006

# OpenTelemetry export (OTLP/HTTP JSON), e.g. to a local Collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20xyz
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
# OTEL_SERVICE_NAME=vid2context
# OTEL_BSP_SCHEDULE_DELAY=5000
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
# OTEL_SDK_DISABLED=false

# Another env file to load before ./.env, e.g. for the MCP server started from
# another project's directory.
# VID2CONTEXT_ENV_FILE=/home/you/.config/vid2context/.env

# ---------------------------------------------------------------- local (your machine)

# Any OpenAI-compatible speech-to-text server. speaches or faster-whisper-server:
# http://localhost:8000/v1. LocalAI: http://localhost:8080/v1 with model whisper-1.
# LOCAL_STT_BASE_URL=http://localhost:8000/v1
# LOCAL_STT_MODEL=Systran/faster-whisper-large-v3
# LOCAL_STT_API_KEY=

# whisper.cpp (local speech-to-text, Node only). Run the setup script and paste
# the lines it prints: npx tsx providers/stt-whisper-cpp/src/setup.ts
# WHISPER_CPP_MODEL enables the rung: a model name (base.en, small,
# large-v3-turbo-q5_0) under .vid2context/models/whisper/, or a path to a ggml .bin.
# WHISPER_CPP_MODEL=small
# Path to whisper-cli. Default: PATH, then .vid2context/bin/whisper.cpp/.
# WHISPER_CPP_BIN=
# 1 = setup found a GPU build (CUDA, Metal, Vulkan): whisper.cpp runs before other local rungs.
# WHISPER_CPP_GPU=0
# Threads for whisper-cli. Default: CPU threads, at most 8.
# WHISPER_CPP_THREADS=8
# 1 = start a managed whisper-server on demand so the model stays loaded between calls.
# WHISPER_CPP_SERVER=0
# Use an existing whisper-server instead (its /inference endpoint).
# WHISPER_CPP_SERVER_URL=http://127.0.0.1:8080

# Whisper on Transformers.js (local speech-to-text, Node and browser, no binaries
# to build). TRANSFORMERS_STT_MODEL enables the rung: an onnx-community short name
# or a Hugging Face repo id. whisper-base suits CPU and WASM; whisper-large-v3-turbo
# is the better pick on WebGPU or a GPU. Models download once into
# .vid2context/models/transformers/ (VID2CONTEXT_HOME), then run offline.
# TRANSFORMERS_STT_MODEL=whisper-base
# auto (default: cpu in Node, webgpu or wasm in the browser), cpu, cuda, dml, coreml, wasm, webgpu.
# TRANSFORMERS_DEVICE=auto
# Weight precision: one value (fp32, fp16, q8, q4) or encoder=<dtype>,decoder=<dtype>.
# TRANSFORMERS_DTYPE=
# Browser only: URL prefix of self-hosted ONNX Runtime WASM files (default cdn.jsdelivr.net).
# TRANSFORMERS_WASM_PATH=

# In-browser LLMs (providers/llm-browser, browser only). In the web app these come
# from the user's settings after feature detection; they do nothing in Node.
# WebLLM prebuilt model ids, comma-separated, one rung each (needs WebGPU).
# WEBLLM_MODEL=Llama-3.2-1B-Instruct-q4f16_1-MLC
# 1 = use Chrome's built-in Prompt API (on-device Gemini Nano, Chrome 148+).
# CHROME_AI=1

# Local LLM servers (providers/llm-local, docs/guides/local-llm.md). Find what is
# running and get these lines filled in: npx tsx providers/llm-local/src/detect.ts
# Each <SERVER>_MODEL is a comma-separated list; setting it enables the server.

# Ollama: a model you have pulled. num_ctx is sized per request, so long
# transcripts are not truncated. The base URL works with or without /v1.
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# How long the model stays loaded after a request: 30m, -1 (forever), 0 (unload).
# OLLAMA_KEEP_ALIVE=

# LM Studio: the loaded model's id.
# LMSTUDIO_MODEL=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_API_KEY=

# llama.cpp server (llama-server): the --alias or model id from /v1/models.
# LLAMACPP_MODEL=
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_API_KEY=

# vLLM: the served model name.
# VLLM_MODEL=
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=

# Jan: the model id; set JAN_API_KEY when Jan's local server has one.
# JAN_MODEL=
# JAN_BASE_URL=http://localhost:1337/v1
# JAN_API_KEY=

# LocalAI: the model name.
# LOCALAI_MODEL=
# LOCALAI_BASE_URL=http://localhost:8080/v1
# LOCALAI_API_KEY=

# Any other OpenAI-compatible chat server.
# LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_API_KEY=

# ---------------------------------------------------------------- free tiers (your key)
# <PROVIDER>_FALLBACK_KEYS adds extra keys, comma-separated; each becomes its own
# rung with its own quota. Keep <PROVIDER>_API_KEY a single key.
# <PROVIDER>_MODEL replaces a lane's LLM model list (comma-separated, in order).

# Groq: speech-to-text (whisper-large-v3-turbo) and LLMs (qwen3.8-27b,
# gpt-oss-120b, gpt-oss-20b). https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_FALLBACK_KEYS=
# GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Cerebras: gpt-oss-120b, llama-3.3-70b. https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# CEREBRAS_FALLBACK_KEYS=
# CEREBRAS_MODEL=gpt-oss-120b,llama-3.3-70b

# Mistral Experiment plan: mistral-small-latest. https://console.mistral.ai
# MISTRAL_API_KEY=
# MISTRAL_FALLBACK_KEYS=
# MISTRAL_MODEL=mistral-small-latest
# Speech-to-text with Voxtral (segments, no word timestamps).
# MISTRAL_STT_MODEL=voxtral-mini-transcribe-3

# GitHub Models: any GitHub token. https://github.com/settings/tokens
# GITHUB_TOKEN=
# GITHUB_FALLBACK_KEYS=
# GITHUB_MODEL=meta/Llama-3.3-70B-Instruct

# Gemini AI Studio: gemini-2.5-flash-lite. https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_FALLBACK_KEYS=
# GEMINI_MODEL=gemini-2.5-flash-lite
# Native Gemini rungs (providers/llm-native) use the same key with their own model list.
# GEMINI_NATIVE_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite

# NVIDIA NIM: nemotron-3-super-120b-a12b, free (can queue under load). https://build.nvidia.com
# NVIDIA_API_KEY=
# NVIDIA_FALLBACK_KEYS=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# SambaNova Cloud: Llama 3.3 70B, about 20 requests per minute. https://cloud.sambanova.ai
# SAMBANOVA_API_KEY=
# SAMBANOVA_FALLBACK_KEYS=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# Cloudflare Workers AI (REST): Llama 3.3 70B fp8-fast, 10,000 free neurons per
# day. The token needs the Workers AI permission. Pooled entries are a token for
# the same account or <account_id>:<token> for another account.
# https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_FALLBACK_KEYS=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Cloudflare Workers AI speech-to-text (providers/cloudflare-ai): REST uses the
# account id and token above. Models in order, comma-separated.
# CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo,@cf/openai/whisper
# Diarizing speech-to-text over REST (speaker labels when diarization is requested).
# CLOUDFLARE_DIARIZE_MODEL=@cf/deepgram/nova-3

# Inside a Worker only: the name of the Workers AI binding ("ai": { "binding": "AI" }
# in wrangler.jsonc). Turns on Whisper, chat and bge-m3 through the binding, no token.
# CLOUDFLARE_AI_BINDING=AI
# Chat models used through the binding, in order, comma-separated.
# CLOUDFLARE_BINDING_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/openai/gpt-oss-120b,@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct
# Vector size for a CLOUDFLARE_EMBED_MODEL whose size is not built in (bge models are).
# CLOUDFLARE_EMBED_DIMENSIONS=

# Zhipu (Z.ai) GLM Flash, permanently free. https://z.ai/manage-apikey/apikey-list
# ZHIPU_API_KEY=
# ZHIPU_FALLBACK_KEYS=
# ZHIPU_MODEL=glm-4.7-flash
# Mainland endpoint: https://open.bigmodel.cn/api/paas/v4
# ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4

# SiliconFlow: free Qwen3 8B (a step-down, tried late). https://cloud.siliconflow.com
# SILICONFLOW_API_KEY=
# SILICONFLOW_FALLBACK_KEYS=
# SILICONFLOW_MODEL=Qwen/Qwen3-8B
# Mainland endpoint: https://api.siliconflow.cn/v1
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# OpenRouter: free-auto picks the best live :free model (never pinned, they are
# retired without notice). OPENROUTER_MODEL adds explicit rungs; ids without
# :free are paid. https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# OPENROUTER_FALLBACK_KEYS=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------- keyless (no account)

# OVH AI Endpoints: whisper-large-v3-turbo, Llama 3.3 70B, gpt-oss-120b.
# About 2 requests per minute per model per IP.
# OVH_STT_MODEL=whisper-large-v3-turbo
# OVH_MODEL=Meta-Llama-3_3-70B-Instruct,gpt-oss-120b

# Pollinations anonymous tier.
# POLLINATIONS_MODEL=openai-fast

# Kilo Code gateway: free Nemotron models, no key, about 200 requests per hour.
# A key (https://app.kilo.ai) raises the limits; model ids without :free are paid.
# KILO_API_KEY=
# KILO_FALLBACK_KEYS=
# KILO_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free
# KILO_BASE_URL=https://api.kilo.ai/api/gateway

# ---------------------------------------------------------------- paid (last backstop)

# DeepInfra speech-to-text, about $0.0002 per audio minute. https://deepinfra.com/dash/api_keys
# DEEPINFRA_API_KEY=
# DEEPINFRA_FALLBACK_KEYS=
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPINFRA_STT_MODEL=openai/whisper-large-v3-turbo

# Together speech-to-text (80 MB uploads, word timestamps). https://api.together.ai/settings/api-keys
# TOGETHER_API_KEY=
# TOGETHER_FALLBACK_KEYS=
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# TOGETHER_STT_MODEL=openai/whisper-large-v3

# OpenAI: whisper-1 and gpt-5.4-nano. Used only after every free rung failed.
# OPENAI_API_KEY=
# OPENAI_FALLBACK_KEYS=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_STT_MODEL=whisper-1

# Anthropic Messages API (providers/llm-native): prompt caching makes repeat questions about one transcript cheap.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_FALLBACK_KEYS=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-haiku-5-5,claude-sonnet-5-5

# Vertex AI (providers/llm-native): Gemini and Claude billed to your Google Cloud project.
# Token source: GOOGLE_ACCESS_TOKEN (gcloud auth print-access-token, about an hour) on any runtime,
# or VID2CONTEXT_GCE_METADATA=1 on a Google Cloud VM (service account with the cloud-platform scope).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_ACCESS_TOKEN=
# VID2CONTEXT_GCE_METADATA=1
# VERTEX_GEMINI_MODEL=gemini-3.8-flash
# VERTEX_ANTHROPIC_MODEL=claude-haiku-5-5
# VERTEX_ANTHROPIC_LOCATION=global

# ---------------------------------------------------------------- embeddings (docs/guides/embeddings.md)
# With nothing set, OVH keyless bge-m3 is used. An index keeps the model it was
# built with; changing models means re-indexing.

# Rung id new indexes use, e.g. embed/ovh/bge-m3. Default: first enabled rung, free first.
# VID2CONTEXT_EMBED_MODEL=

# Local: Ollama and LM Studio (base URLs above), any OpenAI-compatible server,
# or Transformers.js in Node and the browser (downloads into .vid2context/models).
# OLLAMA_EMBED_MODEL=bge-m3
# LMSTUDIO_EMBED_MODEL=
# LOCAL_EMBED_BASE_URL=http://localhost:8080/v1
# LOCAL_EMBED_MODEL=
# LOCAL_EMBED_API_KEY=
# TRANSFORMERS_EMBED_MODEL=Xenova/multilingual-e5-small

# Free keys. GEMINI_API_KEY, MISTRAL_API_KEY and their _FALLBACK_KEYS are shared with the LLM lanes.
# GEMINI_EMBED_MODEL=gemini-embedding-2
# Jina: free key at https://jina.ai/embeddings
# JINA_API_KEY=
# JINA_FALLBACK_KEYS=
# JINA_EMBED_MODEL=jina-embeddings-v3
# MISTRAL_EMBED_MODEL=mistral-embed
# Cloudflare Workers AI REST: uses CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN above.
# CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-m3

# Keyless and paid.
# OVH_EMBED_MODEL=bge-m3
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- YouTube

# Player clients tried in order for metadata and captions (android, ios).
# A client refused for its own reasons hands over to the next one.
# YOUTUBE_CLIENTS=android,ios
# Client versions. Raise one if YouTube starts rejecting it (HTTP 400).
# YOUTUBE_ANDROID_VERSION=20.10.38
# YOUTUBE_IOS_VERSION=20.10.4

# After a block (bot check on every client, HTTP 429 "automated queries"),
# YouTube calls fail fast for this many seconds instead of prolonging the
# block. 0 turns the pause off.
# YOUTUBE_BLOCK_COOLDOWN_SEC=600

# Optional credentials for blocked IPs, age-restricted or members-only videos.
# The cookie ties every request to your Google account: use a spare account.
# YOUTUBE_COOKIE is a raw Cookie header value (with SAPISID, the matching
# SAPISIDHASH header is derived). The provider never reads files: turning a
# Netscape cookies file into this value is left to the CLI and server.
# Values are never logged.
# YOUTUBE_COOKIE=
# HTTP(S) proxy for YouTube traffic only (Node: CLI, server, MCP, and yt-dlp's
# --proxy for YouTube URLs). LLM, STT and storage calls stay direct. Several
# proxies, comma-separated, rotate per request, and every proxied request uses
# a new connection so a rotating residential gateway changes the exit IP.
# No SOCKS. May hold credentials (http://user:pass@host:port); never logged.
# YOUTUBE_PROXY=
# Proof-of-origin token and the visitorData it was minted for, for when
# YouTube returns empty caption tracks (see docs/guides/youtube.md).
# YOUTUBE_PO_TOKEN=
# YOUTUBE_VISITOR_DATA=

# Innertube WEB client version, used for comments, metadata and browse/search
# (the `next`, `browse` and `search` endpoints). Raise it if those calls start failing.
# YOUTUBE_WEB_VERSION=2.20251110.01.00

# Comments: replies kept per thread (0 turns reply fetching off; max 100) and
# the default sort, top or newest.
# YOUTUBE_COMMENT_REPLIES=5
# YOUTUBE_COMMENTS_SORT=top

# ---------------------------------------------------------------- Supadata (YouTube captions through a hosted API)
# For when YouTube blocks caption downloads from this IP. Supadata fetches
# existing captions from its own IPs (never AI-generated ones). Tried only after
# youtube-captions and ytdlp-captions found nothing. Free plan: 100 credits a
# month, 1 per transcript, from https://dash.supadata.ai. The key is never logged.
# SUPADATA_API_KEY=
# Base URL including /v1, for a proxy.
# SUPADATA_BASE_URL=https://api.supadata.ai/v1
# Most seconds one lookup may take, async job polling included.
# SUPADATA_MAX_WAIT_SEC=120

# ---------------------------------------------------------------- exports

# Notion: an internal integration secret (free) from
# https://www.notion.so/profile/integrations. Share the parent page with the
# integration (page menu, Connections). Obsidian exports need nothing.
# NOTION_TOKEN=
# Page the video pages are created under (its id or link).
# NOTION_PARENT_PAGE_ID=

# ---------------------------------------------------------------- content filters

# SponsorBlock (free, keyless): finds sponsor reads, self-promotion, intros and
# outros in YouTube videos. Only a 4-character hash prefix of the video id is
# sent. Data is CC BY-NC-SA 4.0 (non-commercial). Set 0 to turn lookups off.
# VID2CONTEXT_SPONSORBLOCK=1
# A self-hosted mirror instead of the public server.
# SPONSORBLOCK_API_URL=https://sponsor.ajay.app
# Default categories for skip=1 and get_skip_segments.
# VID2CONTEXT_SKIP_CATEGORIES=sponsor,selfpromo,interaction,intro,outro,preview,filler

# ---------------------------------------------------------------- yt-dlp (any video site, Node only)
# Guide: docs/guides/ytdlp.md. Without YTDLP_PATH or yt-dlp on PATH, the official
# release is downloaded into .vid2context/bin/ (SHA-256 verified) on first use.

# Use this yt-dlp binary instead (never auto-updated).
# YTDLP_PATH=/usr/local/bin/yt-dlp

# 0 = do not check for a new yt-dlp release (the managed copy checks weekly).
# YTDLP_AUTO_UPDATE=1

# One timeout in seconds for every yt-dlp run. Unset: 60 metadata, 120
# playlists and subtitles, 300 audio and comments.
# YTDLP_TIMEOUT_SEC=300

# Most yt-dlp processes at once per Node process.
# YTDLP_CONCURRENCY=2

# Calls allowed to wait for a yt-dlp slot; past this, a call fails at once as
# busy (rate-limited, retry after 5 s) instead of queueing without bound.
# YTDLP_MAX_WAITING=64

# Cookies for sites that want a signed-in session. Values are never logged.
# YTDLP_COOKIES_FILE=/home/you/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=firefox

# ffmpeg for audio extraction (else ffmpeg on PATH, then ~/.local/bin/ffmpeg).
# FFMPEG_PATH=/usr/bin/ffmpeg

# ---------------------------------------------------------------- video and audio downloads (Node only)
# Guide: docs/guides/downloads.md. `vid2context download`, the download_media MCP
# tool, /api/v1/downloads and the web app's Download section. Uses yt-dlp and ffmpeg above.

# On by default locally, off on public servers (VID2CONTEXT_PUBLIC=1).
# 1 = allow on a public server too, 0 = off everywhere.
# VID2CONTEXT_DOWNLOADS=

# Where the CLI and MCP tool save files. Default: the current directory (CLI),
# ~/Downloads/vid2context (MCP).
# VID2CONTEXT_DOWNLOAD_DIR=~/Downloads/vid2context

# Largest file in MB, and longest kept part in minutes. 0 = no limit (default
# locally); public servers default to 1024 MB and 120 minutes.
# VID2CONTEXT_MAX_DOWNLOAD_MB=0
# VID2CONTEXT_MAX_DOWNLOAD_MIN=0

# HTTP server: minutes a finished file stays downloadable, downloads at once,
# jobs kept before new ones are refused, and the longest one download may run (seconds).
# VID2CONTEXT_DOWNLOAD_TTL_MIN=30
# VID2CONTEXT_DOWNLOAD_CONCURRENCY=2
# VID2CONTEXT_MAX_DOWNLOAD_JOBS=50
# VID2CONTEXT_DOWNLOAD_TIMEOUT_SEC=7200

# ---------------------------------------------------------------- ffmpeg and local media (packages/ffmpeg, providers/media-file, providers/media-url)
# ffprobe next to FFMPEG_PATH is found automatically; set this when it lives elsewhere.
# FFPROBE_PATH=/usr/bin/ffprobe

# When no ffmpeg is installed, a static GPL build is downloaded into
# .vid2context/bin/ (Linux x64 and arm64 only, SHA-256 checked) the first time a
# video or stream needs it. 0 turns the download off.
# VID2CONTEXT_FFMPEG_DOWNLOAD=1

# Largest direct media URL downloaded for speech-to-text, in MB (1 MB = 1,048,576 bytes).
# VID2CONTEXT_MAX_MEDIA_MB=200

# ---------------------------------------------------------------- cloud share links (providers/share-links)
# Largest Google Drive, Dropbox or OneDrive file handed to speech-to-text, in MB.
# 25 matches Groq's free tier and OpenAI; the keyless OVH lane takes 10 MB.
# SHARE_LINKS_MAX_MB=25

# ---------------------------------------------------------------- Bilibili (providers/bilibili)
# Optional logged-in session (the SESSDATA cookie value from bilibili.com). Not
# needed for creator or AI subtitles, metadata or audio; sent only to
# api.bilibili.com and never logged.
# BILIBILI_SESSDATA=

# Largest Bilibili audio download for speech-to-text, in MB (about 100 minutes
# at the 64 kbps stream vid2context picks).
# BILIBILI_MAX_AUDIO_MB=50

# ---------------------------------------------------------------- X (providers/x)
# Posts come from X's syndication endpoint, then FxTwitter when that fails.
# 0 turns the FxTwitter fallback off, so only X itself is asked.
# X_FXTWITTER=1

# A self-hosted FxEmbed instance for the fallback.
# X_FXTWITTER_BASE_URL=https://api.fxtwitter.com

# ---------------------------------------------------------------- library storage (docs/guides/library-sqlite.md)

# Storage backend: sqlite (default on Node), postgres, cloudflare, or memory
# (nothing persists). Unset: the enabled backend with the lowest priority wins.
# VID2CONTEXT_STORAGE=sqlite

# Local data directory (library.db, models, cache). Default: ./.vid2context
# VID2CONTEXT_HOME=.vid2context

# SQLite library file, or :memory:. Default: $VID2CONTEXT_HOME/library.db
# VID2CONTEXT_DB=.vid2context/library.db

# Milliseconds a write waits while another process holds the SQLite file.
# VID2CONTEXT_DB_BUSY_TIMEOUT_MS=5000

# Cloudflare Worker storage (providers/storage-cloudflare, docs/guides/cloudflare.md):
# binding names from wrangler.jsonc. D1 enables it; R2 holds large contexts and
# uploaded media; KV holds small state (otherwise a D1 table does).
# VID2CONTEXT_D1=DB
# VID2CONTEXT_R2=MEDIA
# VID2CONTEXT_KV=KV

# Postgres + pgvector (providers/storage-postgres, docs/guides/library-postgres.md).
# Setting a URL enables it and it takes over from SQLite. Free options: Neon or
# Supabase free tier, or a local pgvector/pgvector Docker container. Add
# ?sslmode=require for hosted databases. VID2CONTEXT_DATABASE_URL wins over
# DATABASE_URL, so another app's DATABASE_URL can stay untouched.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# VID2CONTEXT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Schema that holds the tables (created on first start). Default: vid2context
# VID2CONTEXT_PG_SCHEMA=vid2context
# Tenant every row of this instance belongs to; instances with different
# tenants share a database without seeing each other's data. Default: default
# VID2CONTEXT_TENANT=default
# Connections in the pool (Node). Default: 10
# VID2CONTEXT_PG_POOL_MAX=10
# Per-statement timeout in ms, sent at connect. Unset: the server default.
# PgBouncer-style poolers reject it; leave it unset behind one.
# VID2CONTEXT_PG_STATEMENT_TIMEOUT_MS=30000
# Driver: postgres (TCP, Node default) or neon-http (Neon over HTTPS; the
# default on Workers, where DATABASE_URL must point at Neon).
# VID2CONTEXT_PG_DRIVER=postgres
# Neon HTTP endpoint override, for a local Neon proxy or self-hosted Neon.
# VID2CONTEXT_PG_NEON_FETCH_ENDPOINT=http://127.0.0.1:4444/sql

# ---------------------------------------------------------------- HTTP server (npm run start:server, docs/guides/http-api.md)

# PORT=8787
# HOST=127.0.0.1

# API keys, comma-separated. When set, every /api/* route except /health needs
# "Authorization: Bearer <key>". A plain key has full access. A hashed entry
# name:scope:sha256hex (scope read, write or admin) keeps the key out of this
# file: printf %s "$KEY" | sha256sum. Ignored in hosted mode.
# VID2CONTEXT_API_KEYS=

# Requests per minute per key (per client IP without keys), and the burst. 0 = off.
# VID2CONTEXT_RATE_LIMIT=120
# VID2CONTEXT_RATE_BURST=60

# 1 = behind your own reverse proxy: trust X-Forwarded-For / X-Real-IP for the client IP.
# VID2CONTEXT_TRUST_PROXY=0

# Largest JSON body in KB, and how long POST /uploads files are kept. The HTTP
# API caps uploads at 100 MB unless VID2CONTEXT_MAX_UPLOAD_MB is set.
# VID2CONTEXT_MAX_BODY_KB=1024
# VID2CONTEXT_UPLOAD_TTL_MIN=60

# A request running longer than this is answered with 504 timeout.
# VID2CONTEXT_REQUEST_TIMEOUT_MS=300000

# 0 = no JSON access log line per request on stderr.
# VID2CONTEXT_ACCESS_LOG=1

# 0 = ignore provider keys callers send per request (X-Vid2Context-Keys). On by
# default: a key is used for that one request only and never stored or logged.
# VID2CONTEXT_REQUEST_KEYS=1

# Node: how long in-flight requests may finish after SIGTERM or SIGINT.
# VID2CONTEXT_SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------- remote MCP server (packages/mcp-http, docs/guides/remote-mcp.md)

# Static bearer tokens for /mcp, comma-separated. Simplest setup for personal
# use and a tunnel. Make each one long and random: openssl rand -base64 32
# VID2CONTEXT_MCP_TOKENS=

# Turns on OAuth for ChatGPT and Claude.ai connectors: the owner password's
# scrypt hash, from `npx tsx packages/mcp-http/src/bin.ts hash-password`.
# VID2CONTEXT_OWNER_PASSWORD_HASH=

# Public origin connectors use (https://mcp.vid2context.com). Tokens are bound
# to <this>/mcp, and the OAuth metadata points here. Set it behind a tunnel or proxy.
# VID2CONTEXT_MCP_PUBLIC_URL=

# Browser origins allowed to call /mcp and the OAuth token endpoint (CORS and
# the Origin check), comma-separated. Shared with the HTTP API, where it allows
# the web app and the extension (chrome-extension://<id>) to call /api/*. Off by default.
# VID2CONTEXT_CORS_ORIGINS=http://localhost:6274

# Extra Host header values accepted when the server listens on 127.0.0.1.
# VID2CONTEXT_MCP_ALLOWED_HOSTS=

# Requests per minute per token (token bucket). 0 turns the limit off.
# VID2CONTEXT_MCP_RATE_LIMIT=120

# session (Mcp-Session-Id, default on Node) or stateless (default on Workers).
# VID2CONTEXT_MCP_MODE=session
# VID2CONTEXT_MCP_SESSION_IDLE_SEC=1800

# OAuth token lifetimes in seconds: access 1 hour, refresh 30 days by default.
# VID2CONTEXT_OAUTH_ACCESS_TTL_SEC=3600
# VID2CONTEXT_OAUTH_REFRESH_TTL_SEC=2592000

# Redirect URI prefixes OAuth clients may use, comma-separated. Unset: any
# https URI or http on localhost.
# VID2CONTEXT_OAUTH_ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback,https://chatgpt.com/connector

# Token shown by platform.openai.com when you submit the app, served as plain
# text at /.well-known/openai-apps-challenge for domain verification.
# VID2CONTEXT_OPENAI_APPS_CHALLENGE=

# ---------------------------------------------------------------- outbound webhooks (packages/webhooks)

# 1 = allow webhook targets on http: and on this machine or your private network
# (a self-hosted n8n at http://localhost:5678, in Docker or on the LAN). Off by
# default: only public https URLs are accepted. Link-local and cloud metadata
# addresses are refused either way.
# VID2CONTEXT_WEBHOOKS_ALLOW_LOCAL=0

# Public base URL of this API, used to make the links in webhook payloads
# absolute (https://v2c.example.com/api/v1/...). Unset: links are paths.
# VID2CONTEXT_WEBHOOKS_BASE_URL=

# ---------------------------------------------------------------- collections and watch lists (packages/library)

# After a collection refresh adds videos, POST {collection, added, checkedAt}
# here. Retried on 5xx; a failed delivery never fails the refresh.
# VID2CONTEXT_WEBHOOK_URL=https://example.com/hooks/vid2context

# Signs each POST: X-Vid2context-Signature: sha256=<hex HMAC-SHA256 of the body>.
# Unset: the POST is sent unsigned (and a warning is logged).
# VID2CONTEXT_WEBHOOK_SECRET=

# ---------------------------------------------------------------- client libraries (clients/python)

# Read by the Python client and its LangChain and LlamaIndex loaders, not by the
# server. Where the server runs (default http://127.0.0.1:8787) and the bearer
# key to send when that server sets VID2CONTEXT_API_KEYS.
# VID2CONTEXT_API_URL=http://127.0.0.1:8787
# VID2CONTEXT_API_KEY=

# ---------------------------------------------------------------- hosted mode (packages/accounts)

# A public instance with GitHub sign-in, API keys, daily quotas per account, a
# shared transcript cache for public videos and per-IP limits. Off unless 1.
# VID2CONTEXT_HOSTED=0

# Required in hosted mode, 32+ characters: openssl rand -base64 48
# VID2CONTEXT_SESSION_SECRET=
# VID2CONTEXT_SESSION_TTL_DAYS=30

# GitHub OAuth app (Settings, Developer settings, OAuth Apps). Callback URL:
# https://<your host>/api/v1/auth/github/callback. The scope is empty: only the
# GitHub id, login and avatar are read, never an email.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=

# Daily limits per plan, JSON. Fields left out keep their defaults.
# VID2CONTEXT_PLANS={"free":{"requestsPerDay":500,"sttMinutesPerDay":60,"llmCallsPerDay":100,"maxCollectionSize":200}}
# VID2CONTEXT_DEFAULT_PLAN=free

# Anonymous use on the "anonymous" plan, per IP. Requests that can start
# speech-to-text need a Cloudflare Turnstile token checked with this secret.
# VID2CONTEXT_ANONYMOUS=0
# TURNSTILE_SECRET=

# Shared cache for public videos (files and uploads are never shared).
# VID2CONTEXT_SHARED_CACHE_TTL_DAYS=30
# VID2CONTEXT_SHARED_CACHE_PLATFORMS=youtube

# Per-IP token bucket in front of every guarded route.
# VID2CONTEXT_IP_BURST=60
# VID2CONTEXT_IP_PER_MINUTE=120
# Behind a trusted proxy, the header with the client IP (its last address is used).
# VID2CONTEXT_IP_HEADER=x-forwarded-for
# VID2CONTEXT_POST_LOGIN_PATH=/app/

# ---------------------------------------------------------------- Chat bots (packages/bots)

# Telegram: token from @BotFather, and a webhook secret (A-Z a-z 0-9 _ -, e.g. openssl rand -hex 32).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Discord: Application ID and Public Key (General Information). The bot token is only for the setup script.
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# Slack: Signing Secret (Basic Information) and Bot User OAuth Token (xoxb-...).
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# Public HTTPS origin of this server, used by the setup scripts to build webhook URLs.
# BOTS_PUBLIC_BASE_URL=https://v2c.example.com
# Optional allowlists (comma-separated ids) and the per-chat, per-user limit (videos per hour).
# BOTS_ALLOWED_CHATS=
# BOTS_ALLOWED_GUILDS=
# BOTS_ALLOWED_TEAMS=
# BOTS_RATE_LIMIT_PER_HOUR=10

# ---------------------------------------------------------------- Background jobs (packages/jobs)

# Jobs that run at once in the in-process runner, and hours a finished job is kept.
# VID2CONTEXT_JOB_CONCURRENCY=2
# VID2CONTEXT_JOB_TTL_HOURS=72
# Google Cloud Tasks: set all three to enable POST /api/v1/jobs/:id/run and the Cloud Tasks producer.
# VID2CONTEXT_CLOUD_TASKS_QUEUE=projects/<project>/locations/<location>/queues/<queue>
# VID2CONTEXT_CLOUD_TASKS_RUN_URL=https://<your-service>.a.run.app/api/v1
# VID2CONTEXT_CLOUD_TASKS_SERVICE_ACCOUNT=<invoker>@<project>.iam.gserviceaccount.com
# OIDC audience the run endpoint expects; default is VID2CONTEXT_CLOUD_TASKS_RUN_URL.
# VID2CONTEXT_CLOUD_TASKS_AUDIENCE=

# ---------------------------------------------------------------- on-screen text and slides (providers/visual-frames, docs/guides/visual-notes.md)

# Local OCR with tesseract.js, on by default in Node and the browser. 0 turns it off.
# TESSERACT_ENABLED=1
# Tesseract language codes, + or comma separated. eng ships with the package;
# others download once to .vid2context/models/tesseract.
# TESSERACT_LANGS=eng
# Your own directory or URL holding <lang>.traineddata.gz files.
# TESSERACT_LANG_PATH=
# Lines below this confidence (0 to 100) are dropped.
# TESSERACT_MIN_CONFIDENCE=60
# Local vision model in Ollama (uses OLLAMA_BASE_URL). Runs before tesseract when set.
# OLLAMA_VISION_MODEL=qwen2.5vl
# Gemini vision model (uses GEMINI_API_KEY and GEMINI_FALLBACK_KEYS), and the
# minimum seconds between its requests.
# GEMINI_VISION_MODEL=gemini-2.5-flash-lite
# GEMINI_VISION_INTERVAL_SEC=4
# Keyless OVH vision model, and the minimum seconds between its requests
# (OVH allows about 2 per minute per model).
# OVH_VISION_MODEL=Qwen2.5-VL-72B-Instruct
# OVH_VISION_INTERVAL_SEC=30

# ---------------------------------------------------------------- live streams (packages/live)

# Live stream the LIVE=1 test follows for two minutes (default: NASA's ISS stream on YouTube).
# VID2CONTEXT_LIVE_TEST_URL=https://www.youtube.com/watch?v=M3HKLzjvKPc
