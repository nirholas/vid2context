{
  "name": "@vid2context/site",
  "version": "0.1.0",
  "private": true,
  "description": "The vid2context.com landing site and docs: Astro with React islands, built to static files the root Worker serves.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --data-only && astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.12",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lighthouse": "13.6.0",
    "tsx": "4.23.15"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
