---
import { data, formatStars, REPO_URL } from '../data/site.ts';
import { withBase } from '../lib/base.ts';
import ThemeToggle from './islands/ThemeToggle.tsx';
import Logo from './Logo.astro';

const stars = data.stars;
const current = Astro.url.pathname;
const inDocs = current.startsWith(withBase('/docs/'));
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href={withBase('/')} class="nav-logo" aria-label="vid2context home">
      <Logo size={28} />
      <span>vid2context</span>
    </a>
    <nav aria-label="Main" class="nav-links">
      <a href={withBase('/#how')} class="nav-link nav-hide-sm">How it works</a>
      <a href={withBase('/docs/')} class="nav-link" aria-current={inDocs ? 'page' : undefined}>Docs</a>
      <a href={REPO_URL} class="nav-link nav-gh" rel="noopener">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
        <span class="nav-hide-sm">GitHub</span>
        <span class="sr-only nav-show-sm">GitHub</span>
        {stars !== null && (
          <span class="nav-stars" aria-label={`${stars} stars`}>
            {formatStars(stars)}
          </span>
        )}
      </a>
      <ThemeToggle client:idle />
      <a href={withBase('/app/')} class="btn btn-primary nav-cta">Open app</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--v2c-border);
    background: color-mix(in srgb, var(--v2c-bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 4rem;
  }
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--v2c-text);
    font-weight: 650;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.7rem;
    border-radius: var(--v2c-radius-sm);
    color: var(--v2c-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--v2c-text);
  }
  .nav-stars {
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--v2c-border);
    border-radius: var(--v2c-radius-pill);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .nav-cta {
    margin-left: 0.35rem;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
  .nav-show-sm {
    display: none;
  }
  @media (max-width: 640px) {
    .nav-hide-sm {
      display: none;
    }
    .nav-show-sm {
      display: inline;
    }
    .nav-logo span {
      font-size: 1rem;
    }
    .nav-link {
      padding-inline: 0.5rem;
    }
  }
  @media (max-width: 380px) {
    .nav-logo span {
      display: none;
    }
  }
</style>
