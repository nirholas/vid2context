---
/**
 * The library playground's browser script and styles. Docs.astro renders this
 * only on pages with a `widget playground` block; the markup comes from
 * src/lib/playground-render.ts. The script loads @vid2context/core in a Web
 * Worker, so core never ships to any other page.
 */
---

<script>
  import '../../scripts/playground.ts';
</script>

<style is:global>
  .pg {
    --pg-gap: 0.75rem;
    margin-block: 1.75rem;
    border: 1px solid var(--v2c-border);
    border-radius: var(--v2c-radius-lg);
    background: var(--v2c-panel);
    padding: 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    min-width: 0;
  }
  .pg > *,
  .pg-step > *,
  .pg-out > * {
    min-width: 0;
  }
  .prose .pg > * + *,
  .prose .pg-step > * + * {
    margin-top: 0;
  }
  .pg-step {
    display: grid;
    gap: var(--pg-gap);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .pg-step + .pg-step {
    padding-top: 1.25rem;
    border-top: 1px solid var(--v2c-border);
  }
  /* Floated, a legend sits inside its step instead of on the divider line. */
  .pg legend {
    float: left;
    width: 100%;
  }
  .pg legend,
  .pg-editor-label {
    padding: 0;
    margin-bottom: var(--pg-gap);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--v2c-text);
  }
  .pg-seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    justify-self: start;
  }
  .pg-seg-item {
    position: relative;
  }
  .pg-seg-item input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .pg-seg-item span {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.25rem 0.875rem;
    border: 1px solid transparent;
    border-radius: var(--v2c-radius-pill);
    color: var(--v2c-muted);
    font-size: 0.8125rem;
  }
  .pg-seg-item:hover span {
    color: var(--v2c-text);
  }
  .pg-seg-item input:checked + span {
    color: var(--v2c-text);
    border-color: var(--v2c-border-strong);
    background: var(--v2c-surface-2);
  }
  .pg-seg-item input:focus-visible + span {
    outline: 2px solid var(--v2c-text);
    outline-offset: 1px;
  }
  .pg-fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.625rem 0.75rem;
    align-items: start;
  }
  .pg-field {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .pg-wide {
    grid-column: 1 / -1;
  }
  .pg-field > label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--v2c-muted);
  }
  .pg input[type="text"],
  .pg input[type="number"],
  .pg select,
  .pg textarea {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--v2c-border-strong);
    border-radius: var(--v2c-radius-sm);
    background: var(--v2c-surface);
    color: var(--v2c-text);
    font: inherit;
    font-size: 0.875rem;
  }
  .pg textarea {
    font-family: var(--v2c-font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    resize: vertical;
    tab-size: 2;
  }
  .pg input:focus-visible,
  .pg select:focus-visible,
  .pg textarea:focus-visible {
    outline: 2px solid var(--v2c-text);
    outline-offset: 1px;
  }
  .pg select:disabled,
  .pg input:disabled {
    opacity: 0.55;
  }
  .pg-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    align-self: end;
    min-height: 2.5rem;
  }
  .pg-check > label {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--v2c-text);
  }
  .pg-check input {
    width: 1.05rem;
    height: 1.05rem;
    margin: 0;
    accent-color: var(--v2c-text);
  }
  .prose .pg-help {
    margin: 0;
    font-size: 0.75rem;
    color: var(--v2c-subtle);
    line-height: 1.45;
  }
  .prose .pg-help code,
  .prose .pg-summary code {
    font-size: 0.6875rem;
  }
  .prose .pg-summary {
    margin: 0;
    font-size: 0.875rem;
    color: var(--v2c-muted);
  }
  .prose pre.pg-error {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--v2c-danger);
    border-radius: var(--v2c-radius-sm);
    background: var(--v2c-surface);
    color: var(--v2c-danger);
    font-family: var(--v2c-font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .pg [data-pg-panel] {
    display: grid;
    gap: var(--pg-gap);
    justify-items: start;
  }
  .pg [data-pg-panel] > .pg-field,
  .pg [data-pg-panel] > .pg-fields {
    width: 100%;
  }
  .pg [data-pg-panel][hidden],
  .pg [hidden] {
    display: none;
  }
  .pg .btn {
    min-height: 2.25rem;
    padding: 0.4rem 1rem;
    font-size: 0.875rem;
  }
  .pg-secondary {
    margin-top: var(--pg-gap);
    font-size: 0.875rem;
  }
  .pg-secondary summary {
    cursor: pointer;
    color: var(--v2c-muted);
    min-height: 2rem;
    display: flex;
    align-items: center;
  }
  .pg-secondary[open] summary {
    margin-bottom: 0.5rem;
    color: var(--v2c-text);
  }
  .pg-secondary .pg-error {
    margin-top: 0.5rem;
  }
  .pg-result {
    gap: 0.5rem;
  }
  .pg-out pre,
  .pg-call pre {
    margin: 0;
    padding: 0.875rem 1rem;
    overflow: auto;
    font-family: var(--v2c-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre;
  }
  .pg-out pre {
    max-height: 30rem;
  }
  .pg-out pre.pg-is-error {
    color: var(--v2c-danger);
    white-space: pre-wrap;
  }
  .pg-out-actions {
    display: inline-flex;
    gap: 0.375rem;
  }
  .code-label.pg-status {
    white-space: normal;
    overflow: visible;
  }
  .pg-editor-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .pg-editor-head .pg-editor-label {
    margin: 0;
  }
  .pg-inline {
    grid-auto-flow: column;
    align-items: center;
    gap: 0.5rem;
  }
  .pg-inline select {
    width: auto;
    min-height: 2.25rem;
    font-size: 0.8125rem;
  }
  .pg-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .pg [data-pg-run] {
    min-width: 5.5rem;
  }
  @media (max-width: 560px) {
    .pg {
      padding: 0.75rem;
      margin-inline: -0.25rem;
    }
  }
</style>
