---
/**
 * Everything a page with runnable examples needs besides the blocks: the
 * shared server settings dialog, the browser script and the styles. Docs.astro
 * renders it only on pages that have at least one `run <id>` block.
 */
import { CLI_PREFIX } from '../lib/runnable-render.ts';
---

<dialog id="rx-settings" class="rx-dialog" aria-labelledby="rx-settings-title" data-rx-cli={CLI_PREFIX}>
  <form method="dialog" novalidate>
    <h2 id="rx-settings-title">Where examples run</h2>
    <label for="rx-server-url">Server URL</label>
    <input id="rx-server-url" name="server-url" type="url" inputmode="url" placeholder="Empty: this site" spellcheck="false" autocomplete="off" aria-describedby="rx-server-help" />
    <p id="rx-server-help" class="rx-help">
      Any vid2context server: your own deployment, or one started from a clone of the repo with{' '}
      <code>VID2CONTEXT_CORS_ORIGINS=<span data-rx-origin>this origin</span> npm run start:server</code>{' '}
      (it listens on <code>http://127.0.0.1:8787</code>). The CORS variable lets this page read its responses.
    </p>
    <label for="rx-api-key">API key (optional)</label>
    <input id="rx-api-key" name="api-key" type="password" autocomplete="off" spellcheck="false" aria-describedby="rx-key-help" />
    <p id="rx-key-help" class="rx-help">
      Only for servers that set <code>VID2CONTEXT_API_KEYS</code>. Sent as <code>Authorization: Bearer</code>, kept in this tab's
      session storage, and never written into the snippets (they read <code>$VID2CONTEXT_API_KEY</code>).
    </p>
    <p class="rx-input-error" data-rx-settings-error role="alert" hidden></p>
    <div class="rx-dialog-actions">
      <button type="button" class="btn" data-rx-settings-reset>Clear</button>
      <span></span>
      <button type="button" class="btn" data-rx-settings-cancel>Cancel</button>
      <button type="submit" class="btn btn-primary">Save</button>
    </div>
  </form>
</dialog>

<script>
  import '../scripts/runnables.ts';
</script>

<style is:global>
  .rx {
    --rx-gap: 0.75rem;
    margin-block: 1.75rem;
    border: 1px solid var(--v2c-border);
    border-radius: var(--v2c-radius-lg);
    background: var(--v2c-panel);
    padding: 1rem;
    display: grid;
    /* minmax(0, 1fr): long code lines scroll inside their block instead of widening the card. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--rx-gap);
    scroll-margin-top: 5rem;
    min-width: 0;
  }
  .rx > *,
  .rx-code > *,
  .rx-out > * {
    min-width: 0;
  }
  .prose .rx > * + * {
    margin-top: 0;
  }
  .rx-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.625rem;
  }
  .rx-method {
    font-family: var(--v2c-font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.125rem 0.5rem;
    border-radius: var(--v2c-radius-pill);
    border: 1px solid var(--v2c-border-strong);
    color: var(--v2c-text);
    background: var(--v2c-surface-2);
  }
  .rx-method-post {
    background: var(--v2c-text);
    color: var(--v2c-bg);
    border-color: var(--v2c-text);
  }
  .prose .rx-path {
    font-size: 0.8125rem;
    background: none;
    border: 0;
    padding: 0;
    color: var(--v2c-muted);
  }
  .prose a.rx-title {
    font-weight: 600;
    color: var(--v2c-text);
    text-decoration: none;
    margin-left: auto;
  }
  .prose a.rx-title:hover {
    text-decoration: underline;
  }
  .prose .rx-note {
    margin: 0;
    color: var(--v2c-muted);
    font-size: 0.875rem;
  }
  .rx-form {
    display: grid;
    gap: var(--rx-gap);
  }
  .rx-fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.625rem 0.75rem;
    align-items: start;
  }
  .rx-field {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .rx-wide,
  .rx-file {
    grid-column: 1 / -1;
  }
  .rx-field > label,
  .rx-file > label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--v2c-muted);
  }
  .rx input[type="text"],
  .rx input[type="number"],
  .rx select,
  .rx textarea,
  .rx-dialog input {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--v2c-border-strong);
    border-radius: var(--v2c-radius-sm);
    background: var(--v2c-surface);
    color: var(--v2c-text);
    font: inherit;
    font-size: 0.875rem;
  }
  .rx textarea {
    font-family: var(--v2c-font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    resize: vertical;
  }
  .rx input:focus-visible,
  .rx select:focus-visible,
  .rx textarea:focus-visible,
  .rx-dialog input:focus-visible {
    outline: 2px solid var(--v2c-text);
    outline-offset: 1px;
  }
  .rx .rx-filled {
    border-color: var(--v2c-success);
    transition: border-color 0.3s;
  }
  .rx-check {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    align-self: end;
    min-height: 2.5rem;
    font-size: 0.875rem;
  }
  .rx-check input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--v2c-text);
  }
  .rx-check .rx-help {
    flex-basis: 100%;
  }
  .rx-file-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .rx-file-row input {
    font-size: 0.8125rem;
    max-width: 100%;
  }
  .rx-help {
    font-size: 0.75rem;
    color: var(--v2c-subtle);
    line-height: 1.45;
  }
  .prose .rx-help code {
    font-size: 0.6875rem;
  }
  .rx-input-error {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--v2c-danger);
  }
  .rx-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .rx-actions .btn {
    min-height: 2.25rem;
    padding: 0.4rem 1rem;
    font-size: 0.875rem;
  }
  .rx-run {
    min-width: 5.5rem;
  }
  .rx-run.rx-running {
    background: var(--v2c-surface-3);
    color: var(--v2c-text);
  }
  .rx-server {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--v2c-muted);
  }
  .rx .rx-server select {
    width: auto;
    min-height: 2.25rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    max-width: 16rem;
  }
  .rx-gear {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--v2c-border-strong);
    border-radius: var(--v2c-radius-sm);
    background: var(--v2c-surface);
    color: var(--v2c-text);
    cursor: pointer;
  }
  .rx-gear:disabled,
  .rx select:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .rx-health {
    flex-basis: 100%;
    text-align: right;
    min-height: 1em;
  }
  .rx-health::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: var(--v2c-subtle);
    vertical-align: 0.05em;
  }
  .rx-health:empty::before {
    display: none;
  }
  .rx-health[data-state="ok"]::before {
    background: var(--v2c-success);
  }
  .rx-health[data-state="down"]::before {
    background: var(--v2c-danger);
  }
  .rx-code {
    display: grid;
    gap: 0;
  }
  .rx-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }
  .rx-tabs [role="tab"] {
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--v2c-radius-pill);
    background: none;
    color: var(--v2c-muted);
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .rx-tabs [role="tab"]:hover {
    color: var(--v2c-text);
  }
  .rx-tabs [role="tab"][aria-selected="true"] {
    color: var(--v2c-text);
    border-color: var(--v2c-border-strong);
    background: var(--v2c-surface-2);
  }
  .rx-panel pre,
  .rx-out pre {
    margin: 0;
    padding: 0.875rem 1rem;
    overflow: auto;
    font-family: var(--v2c-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre;
  }
  .rx-out pre {
    max-height: 30rem;
  }
  .rx-out pre.rx-error {
    color: var(--v2c-danger);
  }
  .rx-out-actions {
    display: inline-flex;
    gap: 0.375rem;
  }
  .prose a.copy-btn {
    display: inline-flex;
    align-items: center;
    color: var(--v2c-text);
    text-decoration: none;
  }
  .code-label.rx-status {
    white-space: normal;
    overflow: visible;
  }
  .rx-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--v2c-border);
    font-family: var(--v2c-font-mono);
    font-size: 0.6875rem;
    color: var(--v2c-subtle);
  }
  .rx-meta:empty {
    display: none;
  }
  .rx-meta b {
    font-weight: 600;
    color: var(--v2c-muted);
  }
  .prose .rx-clip {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: var(--v2c-subtle);
  }

  /* Snippet colors (src/lib/runnable.ts highlightCode), GitHub dark and light. */
  .rx {
    --tk-str: #a5d6ff;
    --tk-kw: #ff7b72;
    --tk-num: #79c0ff;
    --tk-com: #8b949e;
    --tk-fn: #d2a8ff;
    --tk-key: #7ee787;
    --tk-flag: #79c0ff;
    --tk-var: #ffa657;
  }
  :root[data-theme="light"] .rx {
    --tk-str: #0a3069;
    --tk-kw: #cf222e;
    --tk-num: #0550ae;
    --tk-com: #6e7781;
    --tk-fn: #8250df;
    --tk-key: #116329;
    --tk-flag: #0550ae;
    --tk-var: #953800;
  }
  @media (prefers-color-scheme: light) {
    :root[data-theme="system"] .rx {
      --tk-str: #0a3069;
      --tk-kw: #cf222e;
      --tk-num: #0550ae;
      --tk-com: #6e7781;
      --tk-fn: #8250df;
      --tk-key: #116329;
      --tk-flag: #0550ae;
      --tk-var: #953800;
    }
  }
  .tk-str { color: var(--tk-str); }
  .tk-kw { color: var(--tk-kw); }
  .tk-num { color: var(--tk-num); }
  .tk-com { color: var(--tk-com); font-style: italic; }
  .tk-fn { color: var(--tk-fn); }
  .tk-key { color: var(--tk-key); }
  .tk-flag { color: var(--tk-flag); }
  .tk-var { color: var(--tk-var); }

  .rx-dialog {
    margin: auto;
    width: min(34rem, calc(100vw - 2rem));
    padding: 1.25rem;
    border: 1px solid var(--v2c-border-strong);
    border-radius: var(--v2c-radius-lg);
    background: var(--v2c-panel);
    color: var(--v2c-text);
    box-shadow: var(--v2c-shadow);
  }
  .rx-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
  }
  .rx-dialog form {
    display: grid;
    gap: 0.5rem;
  }
  .rx-dialog h2 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }
  .rx-dialog label {
    font-size: 0.8125rem;
    font-weight: 600;
    margin-top: 0.5rem;
  }
  .rx-dialog .rx-help {
    margin: 0;
  }
  .rx-dialog code {
    font-family: var(--v2c-font-mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .rx-dialog-actions {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  @media (max-width: 560px) {
    .rx {
      padding: 0.75rem;
      margin-inline: -0.25rem;
    }
    .rx-server {
      margin-left: 0;
    }
    .rx-health {
      text-align: left;
    }
    .prose a.rx-title {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
