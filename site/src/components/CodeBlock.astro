---
/** A highlighted code block with a copy button. */
import { highlight } from '../lib/markdown.ts';
import CopyButton from './islands/CopyButton.tsx';

interface Props {
  code: string;
  lang?: string;
  /** Small label above the code, such as a file name. */
  label?: string;
  copy?: boolean;
}
const { code, lang = 'bash', label, copy = true } = Astro.props;
const html = highlight(code, lang);
---

<div class={label ? 'code' : 'code code-compact'}>
  {
    label && (
      <div class="code-bar">
        <span class="code-label">{label}</span>
        {copy && <CopyButton client:visible text={code} />}
      </div>
    )
  }
  {!label && copy && <div class="code-float"><CopyButton client:visible text={code} /></div>}
  <Fragment set:html={html} />
</div>
