---
/** The project logo, inlined from packages/discovery/assets/logo.svg so it never drifts. */
import { readFileSync } from 'node:fs';
import { repoPath } from '../lib/paths.ts';

interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
const source = readFileSync(repoPath('packages/discovery/assets/logo.svg'), 'utf8').replace(/<title[^>]*>.*?<\/title>/, '');
// Only the root <svg> tag gets new size and accessibility attributes; shapes keep theirs.
const svg = source.replace(/<svg\b[^>]*>/, (tag) => {
  const viewBox = tag.match(/viewBox="[^"]*"/)?.[0] ?? '';
  return `<svg xmlns="http://www.w3.org/2000/svg" ${viewBox} width="${size}" height="${size}" aria-hidden="true" focusable="false">`;
});
---

<Fragment set:html={svg} />
