---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base.ts';
---

<Base title="Not found: vid2context" description="This page does not exist." path="/404/" noindex twin={false}>
  <main id="main" class="wrap notfound">
    <p class="notfound-code font-mono" aria-hidden="true">[4:04]</p>
    <h1>Nothing at this timestamp</h1>
    <p>This page does not exist. It may have moved when the docs were reorganized.</p>
    <div class="notfound-links">
      <a class="btn btn-primary" href={withBase('/')}>Back to the home page</a>
      <a class="btn" href={withBase('/docs/')}>Read the docs</a>
    </div>
  </main>
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 7rem 2rem;
    text-align: center;
  }
  .notfound-code {
    font-size: clamp(3rem, 10vw, 5rem);
    line-height: 1;
    color: var(--site-link);
  }
  .notfound h1 {
    margin-top: 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .notfound p:not(.notfound-code) {
    margin-top: 0.75rem;
    color: var(--v2c-muted);
  }
  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
