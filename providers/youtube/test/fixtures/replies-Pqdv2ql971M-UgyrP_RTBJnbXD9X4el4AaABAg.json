il as it’s the only thing that can remove Waxoyl"},"publishedTime":"1 year ago","replyLevel":1,"authorButtonA11y":"@matthewcaughey8898","toolbarStateKey":"EjFVZ3lyUF9SVEJKbmJYRDlYNGVsNEFhQUJBZy5BSjZXbVRYZS13N0FKQlJLREZ5bHFCICwoAQ%3D%3D","translateButtonEntityKey":"EjFVZ3lyUF9SVEJKbmJYRDlYNGVsNEFhQUJBZy5BSjZXbVRYZS13N0FKQlJLREZ5bHFCIP8BKAE%3D"},"author":{"displayName":"@matthewcaughey8898","isVerified":false,"isCurrentUser":false,"isCreator":false,"isArtist":false},"toolbar":{"likeCountLiked":"5","likeCountNotliked":"4","replyCount":"","likeButtonA11y":"Like this reply along with 4 other people","engagementToolbarStyle":{"value":"ENGAGEMENT_TOOLBAR_STYLE_VALUE_DEFAULT"},"likeCountA11y":"4 likes","replyCountA11y":"0 replies","likeInactiveTooltip":"Like","likeActiveTooltip":"Unlike","dislikeInactiveTooltip":"Dislike","dislikeActiveTooltip":"Remove dislike","heartActiveTooltip":"❤ by @Jimports"}}}},{"entityKey":"EjFVZ3lyUF9SVEJKbmJYRDlYNGVsNEFhQUJBZy5BSjZXbVRYZS13N0FKQlJLREZ5bHFCICwoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"engagementToolbarStateEntityPayload":{"key":"EjFVZ3lyUF9SVEJKbmJYRDlYNGVsNEFhQUJBZy5BSjZXbVRYZS13N0FKQlJLREZ5bHFCICwoAQ%3D%3D","likeState":"TOOLBAR_LIKE_STATE_INDIFFERENT","heartState":"TOOLBAR_HEART_STATE_UNHEARTED"}}},{"entityKey":"EjFVZ3lyUF9SVEJKbmJYRDlYNGVsNEFhQUJBZy5BSjZXbVRYZS13N0FKT3ZvWGt5S2lDICgoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"commentEntityPayload":{"key":"EjFVZ3lyUF9SVEJKbmJYRDlYNGVsNEFhQUJBZy5BSjZXbVRYZS13N0FKT3ZvWGt5S2lDICgoAQ%3D%3D","properties":{"commentId":"UgyrP_RTBJnbXD9X4el4AaABAg.AJ6WmTXe-w7AJOvoXkyKiC","content":{"content":"I bought one but i kind of have concerns, may i contact you privately for some advice?"},"publishedTime":"1 year ago","replyLevel":1,"authorButtonA11y":"@ol4746","toolbarStateKey":"EjFVZ3lyUF9SVEJKbmJYRDlYNGVsNEFhQUJBZy5BSjZXbVRYZS13N0FKT3ZvWGt5S2lDICwoAQ%3D%3D","translateButtonEntityKey":"EjFVZ3lyUF9SVEJKbmJYRDlYNGVsNEFhQUJBZy5BSjZXbVRYZS13N0FKT3ZvWGt5S2lDIP8BKAE%3