{
  "name": "@vid2context/provider-storage-postgres",
  "version": "0.1.0",
  "description": "Postgres and pgvector library storage for vid2context: saved contexts, collections, full-text search, KV and vector search, scoped per tenant. Node, and Workers through Neon's HTTP driver.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "workerd": "./src/workers.ts",
      "worker": "./src/workers.ts",
      "default": "./src/index.ts"
    }
  },
  "vid2context": {
    "runtimes": [
      "node",
      "workers"
    ]
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@vid2context/core": "*",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "0.0.17",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta"
  }
}
